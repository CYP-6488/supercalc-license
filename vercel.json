{
  "rewrites": [
    { "source": "/api/get-key", "destination": "/api/get-key.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/verify", "destination": "/api/verify.js" }
  ],
  "headers": [
    {
      "source": "/超级计算器.exe",
      "headers": [
        {
